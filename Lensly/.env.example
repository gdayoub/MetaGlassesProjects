# Generate a random token with scripts/setup.ps1. Never put this token in a public URL.
LENSAGENT_API_TOKEN=
LENSAGENT_DATA_DIR=data
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set true only after checking your API project's free-tier/billing and data-use settings.
GEMINI_ENABLED=false
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# Larger context uses more memory; start small on an 8 GB GPU.
OLLAMA_CONTEXT_LENGTH=4096
LENSAGENT_TIMEOUT_SECONDS=45
LENSAGENT_MAX_OUTPUT_TOKENS=768
LENSAGENT_DAILY_REQUEST_LIMIT=100
LENSAGENT_REQUESTS_PER_MINUTE=10
LENSAGENT_RETENTION_DAYS=7
